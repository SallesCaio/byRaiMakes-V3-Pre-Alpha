rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ==========================================
    // PRODUTOS - Público leitura, Admin escrita
    // ==========================================
    match /produtos/{produtoId} {
      // Leitura pública apenas produtos ativos
      allow read: if resource.data.ativo == true;
      
      // Criação apenas admin autenticado
      allow create: if request.auth != null 
        && isAdmin(request.auth.uid);
      
      // Atualização apenas admin
      allow update: if request.auth != null 
        && isAdmin(request.auth.uid);
      
      // Exclusão apenas admin
      allow delete: if request.auth != null 
        && isAdmin(request.auth.uid);
    }

    // ==========================================
    // CATEGORIAS - Público leitura, Admin escrita
    // ==========================================
    match /categorias/{categoriaId} {
      // Leitura pública apenas categorias ativas
      allow read: if resource.data.ativo == true;
      
      // Escrita apenas admin
      allow create, update, delete: if request.auth != null 
        && isAdmin(request.auth.uid);
    }

    // ==========================================
    // PEDIDOS - Cliente dono, Admin total
    // ==========================================
    match /pedidos/{pedidoId} {
      // Cliente lê apenas seus pedidos
      allow read: if request.auth != null 
        && (resource.data.userId == request.auth.uid 
            || isAdmin(request.auth.uid));
      
      // Criação: login por telefone (sem Auth) OU cliente logado.
      // Checkout é dinâmico por telefone; permite userId 'anonimo' + clienteTelefone válido.
      allow create: if request.resource.data.clienteTelefone is string
        && request.resource.data.clienteTelefone.size() >= 12
        && (request.auth != null 
            && request.resource.data.userId == request.auth.uid
            || request.resource.data.userId == 'anonimo')
        && validatePedido(request.resource.data);
      
      // Atualização: cliente apenas status (cancelar), admin total
      allow update: if request.auth != null 
        && (isAdmin(request.auth.uid)
            || (resource.data.userId == request.auth.uid 
                && request.resource.data.diff(resource.data).affectedKeys()
                    .hasOnly(['status'])));
      
      // Exclusão apenas admin
      allow delete: if request.auth != null 
        && isAdmin(request.auth.uid);
    }

    // ==========================================
    // CLIENTES - Login por telefone (sem Auth obrigatório)
    // ==========================================
    match /clientes/{telefone} {
      // Leitura: pública por telefone (a chave É o telefone de negócio)
      allow read: if request.auth != null;

      // Criação: usuário logado (inclusive anônimo) + campos válidos + LGPD.
      // Telefone é a chave de negócio (login dinâmico, sem CRUD).
      allow create: if request.auth != null
        && request.resource.data.telefone is string
        && request.resource.data.telefone.size() >= 12
        && request.resource.data.nome is string
        && request.resource.data.consentimentoLGPD == true;

      // Atualização: qualquer usuário autenticado (inclusive anônimo)
      // O cliente é identificado por telefone (chave pública); campos são operacionais.
      allow update: if request.auth != null;

      allow delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    // ==========================================
    // CONFIG - Mimo (leitura pública)
    // ==========================================
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }

    // ==========================================

    // ==========================================
    // ADMINS - Marker de administrador (apenas existência)
    // Leitura: qualquer usuário autenticado (necessário p/ AdminAuthGuard validar)
    // Escrita: apenas admin
    // ==========================================
    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }

    match /users/{userId} {
      allow read, write: if request.auth != null 
        && isAdmin(request.auth.uid);
    }

    // ==========================================
    // FEEDBACKS - Cliente avalia (pós-pedido)
    // ==========================================
    match /feedbacks/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.nota is int
        && request.resource.data.nota >= 1
        && request.resource.data.nota <= 5
        && request.resource.data.clienteTelefone is string;
      allow update, delete: if request.auth != null && isAdmin(request.auth.uid);
    }

    // ==========================================
    // CAIXA - Total diário de vendas confirmadas
    // ==========================================
    match /caixa/{data} {
      allow read: if request.auth != null && isAdmin(request.auth.uid);
      allow write: if request.auth != null && isAdmin(request.auth.uid);
    }

    // ==========================================
    // FUNÇÕES AUXILIARES
    // ==========================================
    function isAdmin(uid) {
      return exists(/databases/$(database)/documents/admins/$(uid));
    }

    function validatePedido(data) {
      return data.userId is string
        && data.produtos is list
        && data.total is number
        && data.total >= 0
        && data.status is string
        && data.status in ['pendente', 'confirmado', 'estornado', 'cancelado']
        && data.createdAt is timestamp;
    }
  }
}